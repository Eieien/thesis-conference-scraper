# Copy to .env and fill in.

# Gemini (https://aistudio.google.com/apikey). Check current model IDs before running.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Free tier: keep >= 4s (about 15 requests/min). Paid tier: can go to ~0.5.
GEMINI_MIN_INTERVAL_SECONDS=4

# Conferences starting inside this window are kept.
WINDOW_START=2026-10-01
WINDOW_END=2026-11-30

# SQLite for now; any SQLAlchemy URL works (e.g. postgresql+psycopg://...).
# DATABASE_URL=sqlite:///D:/Projects/conference-scraper/data/scraper.db

# Politeness
REQUEST_DELAY_SECONDS=3
EDAS_DELAY_SECONDS=4
CACHE_TTL_HOURS=72
RESPECT_ROBOTS=true
# USER_AGENT=Mozilla/5.0 (compatible; ConferenceResearchBot/0.1; +mailto:you@example.com)

# WikiCFP categories to walk (JSON list)
# WIKICFP_CATEGORIES=["computer science","artificial intelligence","machine learning"]
WIKICFP_MAX_PAGES=25

# EDAS login, used only by scripts/edas_login.py to fill the login form.
EDAS_USERNAME=
EDAS_PASSWORD=

# Free models tried in order when GEMINI_MODEL is overloaded or out of its daily free quota.
GEMINI_BACKUP_MODELS=["gemini-3.1-flash-lite","gemini-3.1-flash-lite-preview"]

# Groq (free tier) fallback when every Gemini model is busy or out of quota
GROQ_API_KEY=

# Deployed frontends allowed to call the API from the browser (localhost is always allowed).
# CORS_ORIGINS=["https://conferences.example.com"]
